PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/securescope
CLIENT_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# DEV ONLY - lets the scanner reach localhost (for the demo site). Ignored when NODE_ENV=production.
ALLOW_PRIVATE_TARGETS=false
SCHEDULER=on
